{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomojax.dev/protocol/progress.schema.json",
  "anyOf": [
    {
      "anyOf": [
        {
          "$ref": "#/$defs/Started"
        },
        {
          "$ref": "#/$defs/Placed"
        },
        {
          "$ref": "#/$defs/Advanced"
        },
        {
          "$ref": "#/$defs/Finished"
        },
        {
          "$ref": "#/$defs/Note"
        },
        {
          "$ref": "#/$defs/Paused"
        },
        {
          "$ref": "#/$defs/Resumed"
        },
        {
          "$ref": "#/$defs/Preview"
        }
      ],
      "discriminator": {
        "propertyName": "event",
        "mapping": {
          "started": "#/$defs/Started",
          "placed": "#/$defs/Placed",
          "advanced": "#/$defs/Advanced",
          "finished": "#/$defs/Finished",
          "note": "#/$defs/Note",
          "paused": "#/$defs/Paused",
          "resumed": "#/$defs/Resumed",
          "preview": "#/$defs/Preview"
        }
      }
    },
    {
      "anyOf": [
        {
          "$ref": "#/$defs/Result"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ],
      "discriminator": {
        "propertyName": "event",
        "mapping": {
          "result": "#/$defs/Result",
          "error": "#/$defs/Error"
        }
      }
    }
  ],
  "$defs": {
    "Started": {
      "title": "Started",
      "description": "An operation entered on the owning thread.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "started"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "parent",
        "name",
        "label",
        "total",
        "unit"
      ],
      "additionalProperties": false
    },
    "Placed": {
      "title": "Placed",
      "description": "Participating devices in coordinator order.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "placed"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "devices"
      ],
      "additionalProperties": false
    },
    "Advanced": {
      "title": "Advanced",
      "description": "One coherent checkpoint, ETA in active seconds.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "advanced"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "eta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "done",
        "total",
        "metrics",
        "eta"
      ],
      "additionalProperties": false
    },
    "Finished": {
      "title": "Finished",
      "description": "End of a task.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "finished"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "canceled",
            "done",
            "failed"
          ]
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "status"
      ],
      "additionalProperties": false
    },
    "Note": {
      "title": "Note",
      "description": "A message attributed to the active watch.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "note"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "level": {
          "enum": [
            "critical",
            "debug",
            "error",
            "info",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "level",
        "message"
      ],
      "additionalProperties": false
    },
    "Paused": {
      "title": "Paused",
      "description": "The operation has reached a checkpoint and is blocked.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "paused"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time"
      ],
      "additionalProperties": false
    },
    "Resumed": {
      "title": "Resumed",
      "description": "The operation has left its paused checkpoint.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "resumed"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time"
      ],
      "additionalProperties": false
    },
    "Preview": {
      "title": "Preview",
      "description": "Coherent named arrays for this checkpoint.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "preview"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "task": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "arrays": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://tomojax.dev/protocol/arrays.schema.json#/$defs/Array"
          }
        }
      },
      "required": [
        "event",
        "schema",
        "task",
        "time",
        "arrays"
      ],
      "additionalProperties": false
    },
    "Result": {
      "title": "Result",
      "description": "Successful CLI terminal.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "result"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "arrays": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://tomojax.dev/protocol/arrays.schema.json#/$defs/Array"
          }
        },
        "info": {
          "$ref": "#/$defs/Info"
        }
      },
      "required": [
        "event",
        "schema",
        "outputs",
        "method",
        "arrays",
        "info"
      ],
      "additionalProperties": false
    },
    "Info": {
      "title": "Info",
      "description": "Bounded JSON summary, with bulk members referenced separately by JSON Pointer.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "object"
        },
        "arrays": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://tomojax.dev/protocol/arrays.schema.json#/$defs/Array"
          }
        }
      },
      "required": [
        "summary",
        "arrays"
      ],
      "additionalProperties": false
    },
    "Error": {
      "title": "Error",
      "description": "Operational failure with an optional nested parameter path.",
      "type": "object",
      "properties": {
        "event": {
          "enum": [
            "error"
          ]
        },
        "schema": {
          "enum": [
            2
          ]
        },
        "kind": {
          "enum": [
            "canceled",
            "input",
            "internal",
            "invalid_parameter",
            "out_of_memory",
            "superseded"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "event",
        "schema",
        "kind",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
