from array import array
from io import BytesIO
from typing import Self

ENDOFCHAIN: int
FREESECT: int
MAGIC: bytes

class OleDirectoryEntry:
    name: str
    size: int
    isectStart: int
    kids: list[OleDirectoryEntry]

class OleFileIO:
    root: OleDirectoryEntry
    fat: array[int]
    sectorsize: int
    minisectorcutoff: int
    def __init__(self, filename: str) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...
    def close(self) -> None: ...
    def exists(self, filename: str | list[str]) -> bool: ...
    def listdir(self, streams: bool = True, storages: bool = False) -> list[list[str]]: ...
    def openstream(self, filename: str | list[str]) -> BytesIO: ...
    def getsect(self, sect: int) -> bytes: ...
    def sect2array(self, sect: bytes) -> array[int]: ...
    def loadfat_sect(self, sect: bytes | array[int]) -> int | None: ...
