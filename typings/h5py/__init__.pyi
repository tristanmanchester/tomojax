from __future__ import annotations

from collections.abc import Callable, ItemsView, Iterator, MutableMapping, ValuesView
from pathlib import Path
from typing import Any, Literal, Protocol, overload

import numpy as np
from numpy.typing import DTypeLike

class AttributeManager(MutableMapping[str, object]):
    @overload
    def get(self, key: str, default: None = None) -> object | None: ...
    @overload
    def get(self, key: str, default: object) -> object: ...
    def __getitem__(self, key: str) -> object: ...
    def __setitem__(self, key: str, value: object) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...

class _CreationProperties(Protocol):
    def get_nfilters(self) -> int: ...

class _ChunkInfo(Protocol):
    byte_offset: int | None

class _DatasetID(Protocol):
    def get_create_plist(self) -> _CreationProperties: ...
    def get_chunk_info_by_coord(self, origin: tuple[int, ...]) -> _ChunkInfo: ...
    def read_direct_chunk(self, origin: tuple[int, ...]) -> tuple[int, bytes]: ...

class Dataset:
    file: File
    name: str | None
    id: _DatasetID
    is_virtual: bool
    compression: str | None
    fillvalue: object
    attrs: AttributeManager
    shape: tuple[int, ...]
    chunks: tuple[int, ...] | None
    ndim: int
    nbytes: int
    def read_direct(
        self, dest: np.ndarray, source_sel: object = ..., dest_sel: object = ...
    ) -> None: ...
    size: int | None
    dtype: np.dtype[Any]
    # A read returns an array, a NumPy scalar or bytes, by selection and dtype.
    def __getitem__(self, key: object) -> Any: ...
    def __setitem__(self, key: object, value: object) -> None: ...
    def __len__(self) -> int: ...
    def astype(self, dtype: DTypeLike) -> Dataset: ...

class HardLink: ...

class SoftLink:
    path: str
    def __init__(self, path: str) -> None: ...

class ExternalLink:
    filename: str
    path: str
    def __init__(self, filename: str | Path, path: str) -> None: ...

class Group:
    id: object
    file: File
    name: str | None
    def visit_links(self, func: Callable[[str], None]) -> None: ...
    def visititems(self, func: Callable[[str, Dataset | Group], None]) -> None: ...
    attrs: AttributeManager
    @overload
    def get(self, name: str, default: None = None) -> Dataset | Group | None: ...
    @overload
    def get(
        self, name: str, default: None = None, *, getlink: Literal[True]
    ) -> HardLink | SoftLink | ExternalLink | None: ...
    @overload
    def get(self, name: str, default: object) -> Dataset | Group | object: ...
    def require_group(self, name: str) -> Group: ...
    def create_group(self, name: str) -> Group: ...
    def create_dataset(self, name: str, data: object = ..., **kwargs: object) -> Dataset: ...
    def __contains__(self, name: object) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __getitem__(self, name: str) -> Dataset | Group: ...
    def __setitem__(self, name: str, value: object) -> None: ...
    def __delitem__(self, name: str) -> None: ...
    def __len__(self) -> int: ...
    def keys(self) -> Iterator[str]: ...
    def items(self) -> ItemsView[str, Dataset | Group | None]: ...
    def values(self) -> ValuesView[Dataset | Group | None]: ...

class File(Group):
    mode: str
    filename: str
    def __init__(self, name: str | Path, mode: str = "r", **kwargs: object) -> None: ...
    def __enter__(self) -> File: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

def is_hdf5(name: str | Path) -> bool: ...
def string_dtype(encoding: str = "utf-8", length: int | None = None) -> np.dtype[Any]: ...
