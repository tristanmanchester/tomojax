[importlinter]
root_package = tomojax
include_external_packages = True

[importlinter:contract:layers]
name = Layer direction
type = layers
layers =
    tomojax.cli
    tomojax.torch
    tomojax.interactive
    tomojax._workflow
    tomojax._resources
    tomojax._smooth_alignment
    tomojax._calibration
    tomojax._planning
    tomojax._field_of_view
    tomojax._region
    tomojax._loading
    tomojax._loading_geometry
    tomojax._scan
    tomojax._astra
    tomojax.alignment
    tomojax.datasets
    tomojax.io
    tomojax.corrections
    tomojax._data
    tomojax.recon
    tomojax.forward
    tomojax.backends
    tomojax.nuisance
    tomojax.motion
    tomojax.geometry
    tomojax.core
    tomojax.progress
    tomojax._parameters
    tomojax.errors
    tomojax.wire

[importlinter:contract:cli-uses-align-facade]
name = CLI uses alignment facade instead of nested alignment internals
type = forbidden
allow_indirect_imports = True
source_modules =
    tomojax.cli
    tomojax.interactive
    tomojax._smooth_alignment
    tomojax._region
    tomojax._workflow
    tomojax._resources
    tomojax._planning
    tomojax._loading
    tomojax._scan
    tomojax._astra
forbidden_modules =
    tomojax.alignment._geometry
    tomojax.alignment._joint

[importlinter:contract:cli-no-core-geometry]
name = CLI uses geometry facade instead of core geometry internals
type = forbidden
allow_indirect_imports = True
source_modules =
    tomojax.cli
    tomojax.interactive
    tomojax._smooth_alignment
    tomojax._region
    tomojax._workflow
    tomojax._resources
    tomojax._planning
    tomojax._loading
    tomojax._scan
    tomojax._astra
forbidden_modules =
    tomojax.core.geometry

[importlinter:contract:rich-stays-in-the-cli]
name = Only the console script imports Rich, never the library or the worker
type = forbidden
allow_indirect_imports = True
source_modules =
    tomojax.progress
    tomojax.errors
    tomojax.wire
    tomojax.core
    tomojax.geometry
    tomojax.recon
    tomojax.io
    tomojax.alignment
    tomojax.corrections
    tomojax._workflow
    tomojax._loading
    tomojax.interactive
    tomojax.cli.serve
    tomojax.cli._session
    tomojax.cli.envelope
    tomojax.cli.execution
    tomojax.cli.operations
    tomojax.cli._adapters
forbidden_modules =
    rich
    rich_argparse
