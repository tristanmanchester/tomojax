[importlinter]
root_package = tomojax

[importlinter:contract:layers]
name = Layer direction
type = layers
layers =
    tomojax.cli
    tomojax._workflow
    tomojax.alignment
    tomojax.datasets
    tomojax.io
    tomojax._data
    tomojax.recon
    tomojax.forward
    tomojax.backends
    tomojax.nuisance
    tomojax.motion
    tomojax.geometry
    tomojax.core

[importlinter:contract:cli-uses-align-facade]
name = CLI uses alignment facade instead of nested alignment internals
type = forbidden
allow_indirect_imports = True
source_modules =
    tomojax.cli
    tomojax._workflow
forbidden_modules =
    tomojax.alignment._geometry
    tomojax.alignment._model
    tomojax.alignment._objectives
    tomojax.alignment.geometry
    tomojax.alignment.io
    tomojax.alignment.model
    tomojax.alignment.objectives
    tomojax.alignment.pipeline

[importlinter:contract:cli-no-core-geometry]
name = CLI uses geometry facade instead of core geometry internals
type = forbidden
allow_indirect_imports = True
source_modules =
    tomojax.cli
    tomojax._workflow
forbidden_modules =
    tomojax.core.geometry
